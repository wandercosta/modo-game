<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Modo Game" Width="880" Height="560" WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" ResizeMode="CanMinimize" WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI Variable Display, Segoe UI" Foreground="#E6E8EE" UseLayoutRounding="True">
  <Window.Resources>
    <SolidColorBrush x:Key="Accent" Color="#3DDC97"/>
    <SolidColorBrush x:Key="Muted" Color="#7D8496"/>
    <SolidColorBrush x:Key="Card" Color="#12151C"/>

    <Style x:Key="Nav" TargetType="Button">
      <Setter Property="Foreground" Value="#6B7284"/>
      <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets"/>
      <Setter Property="FontSize" Value="20"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Margin" Value="0,4"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="b" Width="46" Height="46" CornerRadius="12" Background="{TemplateBinding Background}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="b" Property="Background" Value="#161A22"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="Chrome" TargetType="Button">
      <Setter Property="Foreground" Value="#7D8496"/>
      <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets"/>
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="b" Width="40" Height="32" CornerRadius="8" Background="Transparent">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="b" Property="Background" Value="#1C2029"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="Ghost" TargetType="Button">
      <Setter Property="Foreground" Value="#C9CDD8"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="b" CornerRadius="8" Padding="12,6" BorderThickness="1" BorderBrush="#2A2F3A" Background="Transparent">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="b" Property="Background" Value="#161A22"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="Toggle" TargetType="CheckBox">
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="CheckBox">
            <Border x:Name="track" Width="38" Height="22" CornerRadius="11" Background="#2A2F3A">
              <Ellipse x:Name="thumb" Width="16" Height="16" Margin="3,0" Fill="#E6E8EE" HorizontalAlignment="Left"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="track" Property="Background" Value="#3DDC97"/>
                <Setter TargetName="thumb" Property="HorizontalAlignment" Value="Right"/>
                <Setter TargetName="thumb" Property="Fill" Value="#0B0D11"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="ScrollBar">
      <Setter Property="Width" Value="6"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ScrollBar">
            <Track x:Name="PART_Track" IsDirectionReversed="True">
              <Track.Thumb>
                <Thumb>
                  <Thumb.Template>
                    <ControlTemplate TargetType="Thumb">
                      <Border CornerRadius="3" Background="#2A2F3A"/>
                    </ControlTemplate>
                  </Thumb.Template>
                </Thumb>
              </Track.Thumb>
            </Track>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <Border CornerRadius="16" Background="#0B0D11" BorderBrush="#1C2029" BorderThickness="1">
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="76"/>
        <ColumnDefinition/>
      </Grid.ColumnDefinitions>

      <!-- Menu lateral -->
      <Border CornerRadius="16,0,0,16" Background="#07080B" BorderBrush="#161A22" BorderThickness="0,0,1,0">
        <StackPanel Margin="0,20,0,0" HorizontalAlignment="Center">
          <Border Width="44" Height="44" CornerRadius="12" Background="#10201A" Margin="0,0,0,22">
            <TextBlock Text="&#xE945;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="20"
                       Foreground="{StaticResource Accent}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <Button x:Name="NavBoost" Style="{StaticResource Nav}" Content="&#xE7FC;" ToolTip="Boost"/>
          <Button x:Name="NavProc" Style="{StaticResource Nav}" Content="&#xE8FD;" ToolTip="Processos"/>
        </StackPanel>
      </Border>

      <Grid Grid.Column="1" Margin="30,0,16,26">
        <Grid.RowDefinitions>
          <RowDefinition Height="64"/>
          <RowDefinition/>
        </Grid.RowDefinitions>

        <!-- Barra de título -->
        <Grid x:Name="TitleBar" Background="Transparent">
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <TextBlock x:Name="PageTitle" Text="Boost" FontSize="22" FontWeight="SemiBold"/>
            <Border x:Name="AdminBadge" CornerRadius="6" Background="#2A2210" Padding="8,3" Margin="12,2,0,0" VerticalAlignment="Center" Visibility="Collapsed">
              <TextBlock Text="Sem administrador: alguns processos não fecham" FontSize="11" Foreground="#E0A33D"/>
            </Border>
          </StackPanel>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
            <Button x:Name="BtnMin" Style="{StaticResource Chrome}" Content="&#xE921;"/>
            <Button x:Name="BtnClose" Style="{StaticResource Chrome}" Content="&#xE8BB;"/>
          </StackPanel>
        </Grid>

        <!-- Página Boost -->
        <Grid x:Name="PageBoost" Grid.Row="1" Margin="0,0,14,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="290"/>
            <ColumnDefinition/>
          </Grid.ColumnDefinitions>

          <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
            <Grid x:Name="BoostBtn" Width="210" Height="210" Cursor="Hand" Background="Transparent">
              <Ellipse x:Name="Halo" Margin="-18" Fill="#3DDC97" Opacity="0"/>
              <Ellipse Margin="-9" Stroke="#1C2029" StrokeThickness="1"/>
              <Ellipse x:Name="Ring" Fill="#12151C" Stroke="#2A2F3A" StrokeThickness="3">
                <Ellipse.Effect>
                  <DropShadowEffect Color="#3DDC97" BlurRadius="0" ShadowDepth="0" Opacity="0"/>
                </Ellipse.Effect>
              </Ellipse>
              <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock x:Name="BtnGlyph" Text="&#xE945;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                           FontSize="54" Foreground="#8A91A3" HorizontalAlignment="Center"/>
                <TextBlock x:Name="BtnLabel" Text="ATIVAR" FontSize="15" FontWeight="SemiBold" Foreground="#8A91A3"
                           HorizontalAlignment="Center" Margin="0,10,0,0"/>
              </StackPanel>
            </Grid>
            <TextBlock x:Name="Status" Text="Analisando…" FontSize="13" Foreground="{StaticResource Muted}"
                       HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" Width="260" Margin="0,26,0,22"/>
            <Grid Width="250">
              <TextBlock Text="RAM em uso" FontSize="12" Foreground="{StaticResource Muted}"/>
              <TextBlock x:Name="RamPct" Text="—" FontSize="12" HorizontalAlignment="Right"/>
            </Grid>
            <Grid Width="250" Margin="0,7,0,0">
              <Border Height="8" CornerRadius="4" Background="#1C2029"/>
              <Border x:Name="RamFill" Height="8" CornerRadius="4" Background="#E0A33D" HorizontalAlignment="Left" Width="0"/>
            </Grid>
            <TextBlock x:Name="RamText" Text="" FontSize="11" Foreground="{StaticResource Muted}" Margin="0,7,0,0" HorizontalAlignment="Center"/>
          </StackPanel>

          <Grid Grid.Column="1" Margin="18,6,0,0">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition/>
            </Grid.RowDefinitions>
            <UniformGrid Columns="3">
              <Border Background="{StaticResource Card}" CornerRadius="12" Padding="16,14" Margin="0,0,8,0">
                <StackPanel>
                  <TextBlock x:Name="StatApps" Text="—" FontSize="26" FontWeight="SemiBold"/>
                  <TextBlock Text="apps para fechar" FontSize="12" Foreground="{StaticResource Muted}"/>
                </StackPanel>
              </Border>
              <Border Background="{StaticResource Card}" CornerRadius="12" Padding="16,14" Margin="4,0">
                <StackPanel>
                  <TextBlock x:Name="StatRam" Text="—" FontSize="26" FontWeight="SemiBold"/>
                  <TextBlock Text="em uso por eles" FontSize="12" Foreground="{StaticResource Muted}"/>
                </StackPanel>
              </Border>
              <Border Background="{StaticResource Card}" CornerRadius="12" Padding="16,14" Margin="8,0,0,0">
                <StackPanel>
                  <TextBlock x:Name="StatPower" Text="—" FontSize="16" FontWeight="SemiBold" Margin="0,6,0,6" TextTrimming="CharacterEllipsis"/>
                  <TextBlock Text="plano de energia" FontSize="12" Foreground="{StaticResource Muted}"/>
                </StackPanel>
              </Border>
            </UniformGrid>
            <Grid Grid.Row="1" Margin="0,22,0,10">
              <TextBlock Text="Maiores consumidores" FontSize="13" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/>
              <Button x:Name="BtnSeeAll" Style="{StaticResource Ghost}" Content="Ver todos" HorizontalAlignment="Right"/>
            </Grid>
            <StackPanel x:Name="TopList" Grid.Row="2"/>
          </Grid>
        </Grid>

        <!-- Página Processos -->
        <Grid x:Name="PageProc" Grid.Row="1" Visibility="Collapsed">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>
          <Grid Margin="0,0,14,12">
            <TextBlock FontSize="13" Foreground="{StaticResource Muted}" VerticalAlignment="Center"
                       Text="Ligado: fecha no boost. Desligado: fica protegido (salvo para as próximas vezes)."/>
            <Button x:Name="BtnRefresh" Style="{StaticResource Ghost}" Content="Atualizar" HorizontalAlignment="Right"/>
          </Grid>
          <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,8,0">
            <StackPanel x:Name="ProcList"/>
          </ScrollViewer>
          <TextBlock x:Name="ProtInfo" Grid.Row="2" FontSize="12" Foreground="{StaticResource Muted}" Margin="0,12,0,0"/>
        </Grid>
      </Grid>
    </Grid>
  </Border>
</Window>
